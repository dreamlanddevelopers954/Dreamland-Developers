'use client';

import Image from 'next/image';
import { useState } from 'react';
import Navbar from '@/components/layout/Navbar';
import { galleryImages } from '@/data/gallery';

const categories = [
  'All',
  'Residential Properties',
  'Commercial Properties',
  'Luxury Villas',
  'Premium Plots',
  'Site Visits',
  'Ongoing Projects',
];

export default function GalleryPage() {
  const [activeCategory, setActiveCategory] = useState('All');
  const [selectedImage, setSelectedImage] = useState<string | null>(null);

  const filteredImages =
    activeCategory === 'All'
      ? galleryImages
      : galleryImages.filter((image) => image.category === activeCategory);

  return (
    <>
      <Navbar />

      <main className="bg-[#f8f7f3] px-6 pb-24 pt-36">
        <div className="mx-auto max-w-7xl">
          <div className="mb-12">
            <p className="mb-5 text-sm uppercase tracking-[0.25em] text-gold">
              Explore Dreamland
            </p>

            <h1 className="font-display text-5xl sm:text-7xl">
              Our gallery
            </h1>

            <p className="mt-5 max-w-2xl text-lg leading-8 text-black/60">
              Discover our residential, commercial, luxury and investment
              property opportunities.
            </p>
          </div>

          <div className="mb-10 flex flex-wrap gap-3">
            {categories.map((category) => (
              <button
                key={category}
                onClick={() => setActiveCategory(category)}
                className={`rounded-full px-5 py-2 text-sm transition ${
                  activeCategory === category
                    ? 'bg-black text-white'
                    : 'border border-black/15 bg-white hover:border-gold'
                }`}
              >
                {category}
              </button>
            ))}
          </div>

          <div className="columns-1 gap-5 sm:columns-2 lg:columns-3">
            {filteredImages.map((image) => (
              <button
                key={image.src}
                onClick={() => setSelectedImage(image.src)}
                className="group relative mb-5 block w-full overflow-hidden rounded-3xl text-left"
              >
                <Image
                  src={image.src}
                  alt={image.title}
                  width={1000}
                  height={800}
                  loading="lazy"
                  className="h-auto w-full transition duration-700 group-hover:scale-105"
                />

                <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-5 pt-16 text-white">
                  <p className="font-display text-xl">{image.title}</p>
                  <p className="mt-1 text-xs text-gold">{image.category}</p>
                </div>
              </button>
            ))}
          </div>
        </div>
      </main>

      {selectedImage && (
        <div
          onClick={() => setSelectedImage(null)}
          className="fixed inset-0 z-[100] grid place-items-center bg-black/90 p-6"
        >
          <Image
            src={selectedImage}
            alt="Selected Dreamland Developers property"
            width={1600}
            height={1200}
            className="max-h-[90vh] w-auto rounded-2xl object-contain"
          />
        </div>
      )}
    </>
  );
}
